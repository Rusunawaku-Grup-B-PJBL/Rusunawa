{
  "info": {
    "_postman_id": "8b8f6e7a-52e2-4d3c-9c2b-rusunawa-api",
    "name": "Rusunawa API - 10 Basic Tests",
    "description": "Collection pengujian dasar API Rusunawa berdasarkan route, FormRequest, controller, middleware, dan seeder yang diperiksa. Jalankan berurutan menggunakan Collection Runner. Hasil baru dianggap aktual setelah Collection dijalankan pada server lokal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "resident_token",
      "value": ""
    },
    {
      "key": "room_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Login Admin (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Login menggunakan akun dari UserSeeder. Menyimpan token ke collection variable admin_token.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@ubbg.ac.id\",\n  \"password\": \"password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Response contains admin token\", function () {",
              "    pm.expect(body).to.have.nested.property(\"data.token\");",
              "});",
              "if (body.data && body.data.token) {",
              "    pm.collectionVariables.set(\"admin_token\", body.data.token);",
              "}"
            ]
          }
        }
      ]
    },

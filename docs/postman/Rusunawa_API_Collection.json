          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Room collection contains data array\", function () {",
              "    pm.expect(body).to.have.property(\"data\");",
              "    pm.expect(body.data).to.be.an(\"array\");",
              "});",
              "if (body.data && body.data.length > 0) {",
              "    pm.collectionVariables.set(\"room_id\", String(body.data[0].id));",
              "}"
            ]
          }
        }
